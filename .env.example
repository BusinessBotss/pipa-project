# ── Pipa Group — environment variables ─────────────────────────────
# Copy to .env.local and fill in. NEVER commit real secrets.
# The app runs fine with NONE of these set (local/mock mode): inquiries
# return { ok:true, persisted:false, reason:"SUPABASE_NOT_CONFIGURED" }.

# Public site config -------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Primary WhatsApp number for the group (digits only) = WHATSAPP_NUMBERS.general.
NEXT_PUBLIC_WHATSAPP_DEFAULT="5584994196079"

# Supabase -----------------------------------------------------------
# URL + anon/publishable key are safe to expose (client-side, behind RLS).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""          # classic anon key OR new publishable key
# Service role key — SERVER ONLY. Required to PERSIST leads (bypasses RLS).
# NEVER prefix with NEXT_PUBLIC. NEVER ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# n8n automation (server-side, optional) -----------------------------
# If unset, leads still save to Supabase; dispatch is simply skipped.
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# Staff Dashboard
STAFF_DASHBOARD_ENABLED=false
STAFF_DASHBOARD_PASSWORD=
